# ===========================================
# Speech-Document-Extractor Configuration
# ===========================================

# --- Provider Selection ---
# Options: "mock", "whisper"
SPEECH_PROVIDER=mock

# Options: "mock", "paddleocr"
OCR_PROVIDER=mock

# --- Application Settings ---
APP_NAME=Speech-Document-Extractor
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DEBUG=false

# --- File Limits ---
MAX_FILE_SIZE_MB=25

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Whisper Settings (only if SPEECH_PROVIDER=whisper) ---
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- API Keys (only if using cloud providers) ---
# OPENAI_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# GOOGLE_VISION_API_KEY=
